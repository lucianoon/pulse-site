# Copie para .env e preencha. O .env não é versionado (veja .gitignore).

# Desenvolvimento: DEBUG=True dispensa SECRET_KEY — uma chave efêmera é gerada
# por processo. Em produção, DEBUG deve ficar False e SECRET_KEY é obrigatória.
DEBUG=True

# Gere uma chave nova, nunca reaproveite exemplo de documentação:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Domínios que a aplicação aceita servir. Em produção, liste os reais.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origens confiáveis para CSRF em produção, com esquema. Ex.:
#   CSRF_TRUSTED_ORIGINS=https://pulse.exemplo.com.br
CSRF_TRUSTED_ORIGINS=

# Opcionais de endurecimento (só têm efeito quando DEBUG=False):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
